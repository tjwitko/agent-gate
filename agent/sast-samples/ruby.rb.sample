require "open3"

class UsersController < ApplicationController
  def ping
    host = params[:host]
    # ruleid: ruby-command-injection, ruby-shell-nonliteral
    out = `ping -c1 #{host}`
    render plain: out
  end

  def ping_system
    # ruleid: ruby-command-injection, ruby-shell-nonliteral
    system("ping -c1 #{params[:host]}")
  end

  def ping_args
    # Separate arguments start no shell.
    # ok: ruby-command-injection, ruby-shell-nonliteral
    system("ping", "-c1", params[:host])
  end

  def ping_open3
    # ruleid: ruby-command-injection, ruby-shell-nonliteral
    out, _ = Open3.capture2("ping -c1 #{params[:host]}")
    render plain: out
  end

  def search
    # ruleid: ruby-sql-injection, ruby-sql-string-built
    @users = User.where("name = '#{params[:name]}'")
  end

  def search_keyword
    # ok: ruby-sql-injection, ruby-sql-string-built
    @users = User.where(name: params[:name])
  end

  def search_bound
    # ok: ruby-sql-injection, ruby-sql-string-built
    @users = User.where("name = ?", params[:name])
  end

  def sorted
    # ruleid: ruby-sql-injection
    @users = User.order(params[:sort])
  end

  def paged
    limit = params[:limit].to_i
    # A sanitised value: the flow is not flagged; the construction still is.
    # ok: ruby-sql-injection
    # ruleid: ruby-sql-string-built, ruby-sql-text-built
    @users = User.find_by_sql("SELECT * FROM users LIMIT #{limit}")
  end

  def raw
    # ruleid: ruby-sql-injection, ruby-sql-string-built
    ActiveRecord::Base.connection.execute("DELETE FROM sessions WHERE token = '" + params[:token] + "'")
  end

  def calc
    # ruleid: ruby-code-injection
    render plain: eval(params[:expr]).to_s
  end

  def model
    # ruleid: ruby-code-injection
    klass = params[:type].constantize
    render json: klass.all
  end

  def report(table)
    # No request data: the construction is flagged, the flow is not.
    # ok: ruby-sql-injection
    # ruleid: ruby-sql-string-built, ruby-sql-text-built
    User.find_by_sql("SELECT count(*) FROM #{table}")
  end

  def lookup
    run_query(build_query(params[:name]))
  end

  def build_query(name)
    # ruleid: ruby-sql-text-built
    "SELECT * FROM users WHERE last_name = '#{name}'"
  end

  def run_query(query)
    # ok: ruby-sql-injection
    ActiveRecord::Base.connection.execute(query)
  end

  def commented_out
    # A query in a comment is not code.
    # ok: ruby-sql-text-built
    # sql = "SELECT * FROM users WHERE id = #{params[:id]}"
  end

  def fetch
    # ruleid: ruby-ssrf
    render plain: Net::HTTP.get(URI(params[:url]))
  end

  def profile
    # Scheme and host are fixed; request data only selects a path on that host.
    # ok: ruby-ssrf
    render plain: Net::HTTP.get(URI("https://api.example.com/users/#{params[:id]}"))
  end

  def status
    # ruleid: ruby-ssrf
    render plain: HTTParty.get("https://#{params[:host]}/status").body
  end

  def next_page
    # Parsing a URL to redirect to connects to nothing.
    # ok: ruby-ssrf
    redirect_to URI.parse(params[:next]).path
  end

  def download
    # ruleid: ruby-path-traversal
    send_file File.join("/srv/uploads", params[:file])
  end

  def download_safe
    # ok: ruby-path-traversal
    send_file File.join("/srv/uploads", File.basename(params[:file]))
  end

  def read_any
    # ruleid: ruby-path-traversal
    render plain: File.read("/srv/data/#{params[:name]}")
  end

  def parse_untrusted(xml)
    # ruleid: ruby-xxe
    Nokogiri::XML(xml) { |config| config.noent }
  end

  def parse_safely(xml)
    # ok: ruby-xxe
    Nokogiri::XML(xml) { |config| config.strict.nonet }
  end

  def housekeeping
    # ok: ruby-command-injection, ruby-shell-nonliteral
    system("rm -rf /tmp/cache")
  end
end

# A credential split or encoded is still a credential in the source.
# ruleid: ruby-assembled-credential
API_KEY = "sk-live-" + "4f9a8b7c6d5e"
# ruleid: ruby-assembled-credential
DB_PASSWORD = Base64.decode64("aHVudGVyMi1wcm9kLTIwMjY=")
# ruleid: ruby-assembled-credential
SECRET_TOKEN = ["ghp_", "a1B2c3D4", "e5F6g7H8"].join
# ok: ruby-assembled-credential
TOKEN_URL = "https://" + "auth.example.com/token"
# ok: ruby-assembled-credential
AUTH_TOKEN = "Bearer " + ENV.fetch("TOKEN")
