const express = require("express");
const { exec, execFile } = require("child_process");
const { Pool } = require("pg");

const app = express();
const pool = new Pool();

app.get("/ping", (req, res) => {
  // ruleid: javascript-command-injection, javascript-shell-nonliteral
  exec(`ping -c1 ${req.query.host}`, (err, out) => res.send(out));
});

app.get("/ping-safe", (req, res) => {
  // ok: javascript-command-injection
  execFile("ping", ["-c1", req.query.host], (err, out) => res.send(out));
});

app.get("/user", async (req, res) => {
  // ruleid: javascript-sql-injection, javascript-sql-string-built, javascript-sql-text-built
  const r = await pool.query(`SELECT * FROM users WHERE name = '${req.query.n}'`);
  res.json(r.rows);
});

app.get("/user-safe", async (req, res) => {
  // ok: javascript-sql-injection, javascript-sql-string-built
  const r = await pool.query("SELECT * FROM users WHERE name = $1", [req.query.n]);
  res.json(r.rows);
});

app.get("/page", async (req, res) => {
  const limit = parseInt(req.query.limit, 10);
  // A sanitised value: the flow is not flagged; the construction still is.
  // ok: javascript-sql-injection
  // ruleid: javascript-sql-string-built, javascript-sql-text-built
  const r = await pool.query(`SELECT * FROM users LIMIT ${limit}`);
  res.json(r.rows);
});

app.post("/calc", (req, res) => {
  // ruleid: javascript-code-injection
  res.send(String(eval(req.body.expr)));
});

app.get("/match", (req, res) => {
  const re = /^[a-z]+$/;
  // ok: javascript-command-injection
  res.send(String(re.exec(req.query.s)));
});

function report(table) {
  // ok: javascript-sql-injection
  // ruleid: javascript-sql-string-built, javascript-sql-text-built
  return pool.query(`SELECT count(*) FROM ${table}`);
}

app.get("/destructured", (req, res) => {
  const { host } = req.query;
  // ruleid: javascript-command-injection, javascript-shell-nonliteral
  exec("ping -c1 " + host);
});

app.get("/via-helper", (req, res) => {
  ping(req.query.host);
});

function ping(host) {
  // Not followed across the call; the construction is reported on its own.
  // ok: javascript-command-injection
  // ruleid: javascript-shell-nonliteral
  exec("ping -c1 " + host);
}

function housekeeping() {
  // ok: javascript-command-injection, javascript-shell-nonliteral
  exec("rm -rf /tmp/cache");
}

// A query built in one function and executed in another: the text is reported where it is built.
function buildQuery(name) {
  // ruleid: javascript-sql-text-built
  return `SELECT * FROM users WHERE last_name = '${name}'`;
}

app.get("/lookup", async (req, res) => {
  // Taint does follow a call's return value: request data goes in, the query comes out.
  // ok: javascript-sql-string-built, javascript-sql-text-built
  // ruleid: javascript-sql-injection
  res.json((await pool.query(buildQuery(req.query.name))).rows);
});

async function tagged(name) {
  // A tagged template is parameterised by its tag.
  // ok: javascript-sql-text-built
  return db.query(sql`SELECT * FROM users WHERE last_name = ${name}`);
}

async function byEvent(eventId, providerId) {
  // A parameterised query extended with another placeholder clause builds nothing from a value.
  let query = "SELECT * FROM webhooks WHERE event_id = $1";
  const params = [eventId];
  if (providerId) {
    // ok: javascript-sql-text-built, javascript-sql-string-built
    query += " AND provider_id = $2";
    params.push(providerId);
  }
  return pool.query(query, params);
}

// A credential split or encoded is still a credential in the source.
