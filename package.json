{
  "name": "@tjwitko/agent-gate",
  "version": "1.1.2",
  "description": "Deterministic security controls that run against a project and return one verdict: clean, blocked, or could-not-run.",
  "type": "module",
  "main": "./bin/validate.mjs",
  "exports": {
    ".": "./bin/validate.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "agent-gate": "./bin/validate.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "agent/",
    "!agent/*.test.mjs",
    "!agent/agent-loop.mjs",
    "!agent/anthropic-adapter.mjs",
    "!agent/README.md",
    "action.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test agent/*.test.mjs",
    "corpus": "node corpus/run.mjs",
    "corpus:vendor": "node corpus/vendor.mjs",
    "corpus:check": "node corpus/vendor.mjs --check"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@tjwitko/dep-audit-mcp": "git+https://github.com/tjwitko/dep-audit-mcp.git#v1.0.0",
    "@tjwitko/identity-guard-mcp": "git+https://github.com/tjwitko/identity-guard-mcp.git#v1.0.0",
    "@tjwitko/secret-guard-mcp": "git+https://github.com/tjwitko/secret-guard-mcp.git#v1.0.0",
    "@tjwitko/terraform-guard-mcp": "git+https://github.com/tjwitko/terraform-guard-mcp.git#v1.1.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@langfuse/client": "^5.10.1",
    "@langfuse/otel": "^5.10.1",
    "@langfuse/tracing": "^5.10.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-node": "^0.221.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tjwitko/agent-gate.git"
  },
  "engines": {
    "node": ">=20"
  }
}
