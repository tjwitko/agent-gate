package samples;

import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.sql.Statement;
import java.util.List;
import javax.persistence.EntityManager;
import javax.script.ScriptEngine;
import javax.servlet.http.HttpServletRequest;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.web.bind.annotation.*;

@RestController
public class Samples {
    private JdbcTemplate jdbc;
    private EntityManager em;
    private Connection conn;
    private ScriptEngine engine;

    @GetMapping("/ping")
    public String ping(@RequestParam String host) throws Exception {
        // ruleid: java-command-injection, java-shell-nonliteral
        Process p = Runtime.getRuntime().exec("ping -c1 " + host);
        return "ok";
    }

    @GetMapping("/ping-shell")
    public String pingShell(@RequestParam("host") String host) throws Exception {
        // ruleid: java-command-injection, java-shell-nonliteral
        new ProcessBuilder("sh", "-c", "ping -c1 " + host).start();
        return "ok";
    }

    @GetMapping("/ping-args")
    public String pingArgs(@RequestParam String host) throws Exception {
        // An argument array starts no shell; the request value is one argument.
        // ok: java-command-injection, java-shell-nonliteral
        Runtime.getRuntime().exec(new String[]{"ping", "-c1", host});
        return "ok";
    }

    @GetMapping("/user")
    public List<?> user(@RequestParam String name) {
        // ruleid: java-sql-injection, java-sql-string-built, java-sql-text-built
        return jdbc.queryForList("SELECT * FROM users WHERE name = '" + name + "'");
    }

    @GetMapping("/user-safe")
    public List<?> userSafe(@RequestParam String name) {
        // ok: java-sql-injection, java-sql-string-built
        return jdbc.queryForList("SELECT * FROM users WHERE name = ?", name);
    }

    @GetMapping("/item/{id}")
    public Object item(@PathVariable String id) {
        // ruleid: java-sql-injection, java-sql-text-built
        return em.createNativeQuery(String.format("SELECT * FROM items WHERE id = '%s'", id)).getResultList();
    }

    @GetMapping("/page")
    public List<?> page(@RequestParam String limit) {
        int n = Integer.parseInt(limit);
        // A sanitised value: the flow is not flagged; the construction still is.
        // ok: java-sql-injection
        // ruleid: java-sql-string-built, java-sql-text-built
        return jdbc.queryForList("SELECT * FROM users LIMIT " + n);
    }

    public ResultSet servlet(HttpServletRequest request) throws Exception {
        String name = request.getParameter("name");
        Statement st = conn.createStatement();
        // ruleid: java-sql-injection, java-sql-string-built, java-sql-text-built
        return st.executeQuery("SELECT * FROM users WHERE name = '" + name + "'");
    }

    public ResultSet servletSafe(HttpServletRequest request) throws Exception {
        PreparedStatement ps = conn.prepareStatement("SELECT * FROM users WHERE name = ?");
        // ok: java-sql-injection
        ps.setString(1, request.getParameter("name"));
        return ps.executeQuery();
    }

    @PostMapping("/calc")
    public Object calc(@RequestBody String expr) throws Exception {
        // ruleid: java-code-injection
        return engine.eval(expr);
    }

    public ResultSet report(String table) throws Exception {
        Statement st = conn.createStatement();
        // No request data: the construction is flagged, the flow is not.
        // ok: java-sql-injection
        // ruleid: java-sql-string-built, java-sql-text-built
        return st.executeQuery("SELECT count(*) FROM " + table);
    }

    // WebGoat's shape: the request value crosses two calls before it is executed, which the taint rule
    // cannot follow. The text is reported where it is built.
    @PostMapping("/lookup")
    public ResultSet lookup(@RequestParam String name) throws Exception {
        return runQuery(buildQuery(name));
    }

    private String buildQuery(String name) {
        // ruleid: java-sql-text-built
        return "SELECT * FROM users WHERE last_name = '" + name + "'";
    }

    private ResultSet runQuery(String query) throws Exception {
        // ok: java-sql-injection, java-sql-string-built
        return conn.createStatement().executeQuery(query);
    }

    public void fixedShell() throws Exception {
        // A shell, but its command is fixed: an array variable of literals builds nothing.
        String[] args = new String[] { "/bin/sh", "-c", "echo $PPID" };
        // ok: java-command-injection, java-shell-nonliteral
        Runtime.getRuntime().exec(args);
    }

    // A credential split or encoded is still a credential in the source.
    // ruleid: java-assembled-credential
    private static final String API_KEY = "sk-live-" + "4f9a8b7c6d5e";
    // ruleid: java-assembled-credential
    private final String dbPassword = new String(java.util.Base64.getDecoder().decode("aHVudGVyMi1wcm9k"));
    // ok: java-assembled-credential
    private final String tokenUrl = "https://" + "auth.example.com/token";

    @GetMapping("/fetch")
    public String fetch(@RequestParam String url) throws Exception {
        // ruleid: java-ssrf
        return new String(new java.net.URL(url).openStream().readAllBytes());
    }

    @GetMapping("/profile")
    public String profile(@RequestParam String id) throws Exception {
        // Scheme and host are fixed; request data only selects a path on that host.
        // ok: java-ssrf
        return new String(new java.net.URL("https://api.example.com/users/" + id).openStream().readAllBytes());
    }

    @GetMapping("/next")
    public org.springframework.http.ResponseEntity<Void> next(@RequestParam String target) throws Exception {
        // Building a URI to redirect to connects to nothing (WebGoat's open-redirect lessons).
        // ok: java-ssrf
        return org.springframework.http.ResponseEntity.status(302).location(URI.create(target)).build();
    }

    @GetMapping("/download")
    public byte[] download(@RequestParam String file) throws Exception {
        // ruleid: java-path-traversal
        return java.nio.file.Files.readAllBytes(Paths.get("/srv/uploads", file));
    }

    @GetMapping("/download-safe")
    public byte[] downloadSafe(@RequestParam String file) throws Exception {
        // ok: java-path-traversal
        return java.nio.file.Files.readAllBytes(Paths.get("/srv/uploads", FilenameUtils.getName(file)));
    }

    public Object parseUntrusted(java.io.InputStream in) throws Exception {
        // ruleid: java-xxe
        DocumentBuilderFactory dbf = DocumentBuilderFactory.newInstance();
        return dbf.newDocumentBuilder().parse(in);
    }

    public Object parseSafely(java.io.InputStream in) throws Exception {
        // ok: java-xxe
        DocumentBuilderFactory dbf = DocumentBuilderFactory.newInstance();
        dbf.setFeature("http://apache.org/xml/features/disallow-doctype-decl", true);
        return dbf.newDocumentBuilder().parse(in);
    }

    public void housekeeping() throws Exception {
        // ok: java-command-injection, java-shell-nonliteral
        Runtime.getRuntime().exec("rm -rf /tmp/cache");
    }
}
