{
  "name": "@tjwitko/agent-gate",
  "version": "1.0.0",
  "description": "Deterministic security controls that run against a project and return one verdict: clean, blocked, or could-not-run.",
  "type": "module",
  "main": "index.mjs",
  "bin": {
    "agent-gate": "./bin/validate.mjs"
  },
  "scripts": {
    "test": "node --test agent/*.test.mjs",
    "corpus": "node corpus/run.mjs",
    "corpus:vendor": "node corpus/vendor.mjs",
    "corpus:check": "node corpus/vendor.mjs --check"
  },
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tjwitko/dep-audit-mcp": "git+https://github.com/tjwitko/dep-audit-mcp.git",
    "@tjwitko/identity-guard-mcp": "git+https://github.com/tjwitko/identity-guard-mcp.git",
    "@tjwitko/secret-guard-mcp": "git+https://github.com/tjwitko/secret-guard-mcp.git",
    "@tjwitko/terraform-guard-mcp": "git+https://github.com/tjwitko/terraform-guard-mcp.git",
    "axios": "^1.19.0",
    "yaml": "^2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@langfuse/client": "^5.10.1",
    "@langfuse/otel": "^5.10.1",
    "@langfuse/tracing": "^5.10.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-node": "^0.221.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tjwitko/agent-gate.git"
  },
  "engines": {
    "node": ">=20"
  }
}
